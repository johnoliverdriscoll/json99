prefix=@CMAKE_INSTALL_PREFIX@
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: json99
Description: Forward-only JSON parser for C99 with caller-owned parsing contexts
Version: @PROJECT_VERSION@
Libs: -L"${libdir}" @JSON99_PKGCONFIG_LIBS@
Cflags: -I"${includedir}"
